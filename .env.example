# Copia este archivo a .env (desarrollo). No pongas secretos aquí: todo VITE_* termina en el bundle.
VITE_API_URL=http://localhost:3001/sero-web/api
VITE_WS_URL=ws://localhost:3001/ws
# API externa que usan auth/campana/dashboard/encuesta.service.js (src/api/rest.js)
VITE_REST_URL=http://localhost:3000/api
# Token PÚBLICO de Mapbox (pk.…) para los mapas de la web. Va en el bundle: restríngelo por URL en Mapbox
# (dominios de la web y http://localhost:5173). No es el MAPBOX_TOKEN del backend.
VITE_MAPBOX_TOKEN=
